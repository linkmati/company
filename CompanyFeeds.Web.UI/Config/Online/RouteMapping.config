<?xml version="1.0"?>
<RouteMappingConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<Routes>
		<RouteItem Url="" Controller="Home" Action="Index">
			<Defaults>
				<item>
					<key>page</key>
					<value>0</value>
				</item>
				<item>
					<key>type</key>
					<value>Xhtml</value>
				</item>
			</Defaults>
		</RouteItem>
		<RouteItem Url="page/{page}" Controller="Home" Action="Index">
			<Constraints>
				<item>
					<key>page</key>
					<value>[\d]+</value>
				</item>
			</Constraints>
			<Defaults>
				<item>
					<key>type</key>
					<value>Xhtml</value>
				</item>
			</Defaults>
		</RouteItem>
		<RouteItem Url="rss/" Controller="Home" Action="Index">
			<Defaults>
				<item>
					<key>page</key>
					<value>0</value>
				</item>
				<item>
					<key>type</key>
					<value>Rss</value>
				</item>
			</Defaults>
		</RouteItem>
		<RouteItem Url="register/" Controller="Users" Action="Edit">
			<Defaults>
				<item>
					<key>id</key>
					<value>0</value>
				</item>
			</Defaults>
		</RouteItem>
		<RouteItem Url="user/{id}/edit/" Controller="Users" Action="Edit">
			<Constraints>
				<item>
					<key>id</key>
					<value>[\d]+</value>
				</item>
			</Constraints>
		</RouteItem>
		<RouteItem Url="about/" Controller="Home" Action="About" />
		<RouteItem Url="terms/" Controller="Home" Action="Terms" />
		<RouteItem Url="search/" Controller="Home" Action="SearchResults" />
		<RouteItem Url="latest/{page}/" Controller="Home" Action="Latest">
			<Defaults>
				<item>
					<key>page</key>
					<value>0</value>
				</item>
				<item>
					<key>type</key>
					<value>Xhtml</value>
				</item>
			</Defaults>
		</RouteItem>
		<RouteItem Url="rss/latest" Controller="Home" Action="Latest">
			<Defaults>
				<item>
					<key>page</key>
					<value>0</value>
				</item>
				<item>
					<key>type</key>
					<value>Rss</value>
				</item>
			</Defaults>
		</RouteItem>
		<RouteItem Url="rss/flags/" Controller="Flags" Action="List" />
		<RouteItem Url="commands/cacheclear/" Controller="Commands" Action="CacheClear" />
		<RouteItem Url="commands/cachestatus/" Controller="Commands" Action="CacheStatus" />
		<RouteItem Url="contact/" Controller="Feedback" Action="Contact" />
		<RouteItem Url="report-bug/" Controller="Feedback" Action="ReportBug" />
		<RouteItem Url="login/" Controller="Users" Action="Login" />
		<RouteItem Url="logout/" Controller="Users" Action="Logout" />
		<RouteItem Url="user/subscriptions/add/" Controller="Subscriptions" Action="Add" />
		<RouteItem Url="user/subscriptions/remove/" Controller="Subscriptions" Action="Remove" />
		<RouteItem Url="user/subscriptions/" Controller="Subscriptions" Action="List" />
		<RouteItem Url="user/validate/" Controller="Users" Action="ValidateEmail" />
		<RouteItem Url="user/validate-by-admin/" Controller="Users" Action="ValidateEmailByAdmin" />
		<RouteItem Url="sitemaps-detail.xml" Controller="Home" Action="SitemapsDetail" />
		<RouteItem Url="sitemaps.xml" Controller="Home" Action="Sitemaps" />
		<RouteItem Url="users/" Controller="Users" Action="ListUsersWithEmailNotValidated" />
		<RouteItem Url="user/{id}/" Controller="Users" Action="Detail">
			<Defaults>
				<item>
					<key>type</key>
					<value>Xhtml</value>
				</item>
			</Defaults>
		</RouteItem>
		<RouteItem Url="user/{id}/{type}/" Controller="Users" Action="Detail">
			<Constraints>
				<item>
					<key>type</key>
					<value>Rss</value>
				</item>
				<item>
					<key>id</key>
					<value>\d+</value>
				</item>
			</Constraints>
		</RouteItem>
		<RouteItem Url="archives/" Controller="Archives" Action="ListDates" />
		<RouteItem Url="archives/{year}-{month}-{day}/" Controller="Archives" Action="Detail">
			<Constraints>
				<item>
					<key>year</key>
					<value>[\d]+</value>
				</item>
				<item>
					<key>month</key>
					<value>[\d]+</value>
				</item>
				<item>
					<key>day</key>
					<value>[\d]+</value>
				</item>
			</Constraints>
		</RouteItem>
		<RouteItem Url="submit-press-release/" Controller="Entries" Action="Edit">
			<Defaults>
				<item>
					<key>id</key>
					<value>0</value>
				</item>
			</Defaults>
		</RouteItem>
		<RouteItem Url="submit-company/" Controller="Companies" Action="Edit">
			<Defaults>
				<item>
					<key>companyTag</key>
					<value></value>
				</item>
			</Defaults>
		</RouteItem>
		<RouteItem Url="entries/reportabuse/" Controller="Entries" Action="ReportAbuse" />
		<RouteItem Url="entries/delete/" Controller="Entries" Action="Delete" />
		<RouteItem Url="press-releases/{categoryTag}/{page}/" Controller="Categories" Action="Detail">
			<Defaults>
				<item>
					<key>page</key>
					<value>0</value>
				</item>
				<item>
					<key>type</key>
					<value>Xhtml</value>
				</item>
			</Defaults>
			<Constraints>
				<item>
					<key>categoryTag</key>
					<value>[\w-]+</value>
				</item>
			</Constraints>
		</RouteItem>
		<RouteItem Url="{type}/{categoryTag}/{page}" Controller="Categories" Action="Detail">
			<Defaults>
				<item>
					<key>page</key>
					<value>0</value>
				</item>
			</Defaults>
			<Constraints>
				<item>
					<key>categoryTag</key>
					<value>[\w-]+</value>
				</item>
				<item>
					<key>type</key>
					<value>Rss</value>
				</item>
			</Constraints>
		</RouteItem>
		<RouteItem Url="agency/{agencyTag}/" Controller="Agencies" Action="Detail">
			<Constraints>
				<item>
					<key>agencyTag</key>
					<value>[\w-]+</value>
				</item>
			</Constraints>
		</RouteItem>
		<RouteItem Url="agency/{agencyTag}/edit/" Controller="Agencies" Action="Edit">
			<Constraints>
				<item>
					<key>agencyTag</key>
					<value>[\w-]+</value>
				</item>
			</Constraints>
		</RouteItem>
		<RouteItem Url="register-agency/" Controller="Agencies" Action="Edit" />
		<RouteItem Url="agency/" Controller="Agencies" Action="Edit" />
		<RouteItem Url="companies/get/" Controller="Companies" Action="Get" />
		<RouteItem Url="companies/no-relevance/" Controller="Companies" Action="SetNoRelevance" />
		<RouteItem Url="companies/listnames/" Controller="Companies" Action="ListNames" />
		<RouteItem Url="companies/search/" Controller="Companies" Action="Search" />
		<RouteItem Url="companies/searchexternal/" Controller="Companies" Action="SearchExternal" />
		<RouteItem Url="companies/" Controller="Companies" Action="ListAll" />
		<RouteItem Url="comments/add/" Controller="Comments" Action="Add" />
		<RouteItem Url="comments/unsubscribe/" Controller="Comments" Action="Unsubscribe" />
		<RouteItem Url="comments/" Controller="Comments" Action="ListLatest" />
		<RouteItem Url="{id}/" Controller="Entries" Action="GetShortUrl">
			<Constraints>
				<item>
					<key>id</key>
					<value>[\d]+</value>
				</item>
			</Constraints>
		</RouteItem>
		<RouteItem Url="{companyTag}/{tag}-{id}/" Controller="Entries" Action="Detail">
			<Constraints>
				<item>
					<key>companyTag</key>
					<value>[\w-]+</value>
				</item>
				<item>
					<key>tag</key>
					<value>[\w-]+</value>
				</item>
				<item>
					<key>id</key>
					<value>[\d]+</value>
				</item>
			</Constraints>
		</RouteItem>
		<RouteItem Url="{companyTag}/{tag}-{id}/edit/" Controller="Entries" Action="Edit">
			<Constraints>
				<item>
					<key>companyTag</key>
					<value>[\w-]+</value>
				</item>
				<item>
					<key>tag</key>
					<value>[\w-]+</value>
				</item>
				<item>
					<key>id</key>
					<value>[\d]+</value>
				</item>
			</Constraints>
		</RouteItem>
		<RouteItem Url="{companyTag}/{page}/" Controller="Companies" Action="Detail">
			<Defaults>
				<item>
					<key>page</key>
					<value>0</value>
				</item>
			</Defaults>
			<Constraints>
				<item>
					<key>companyTag</key>
					<value>[\w-]+</value>
				</item>
				<item>
					<key>page</key>
					<value>[\d]+</value>
				</item>
			</Constraints>
		</RouteItem>
		<RouteItem Url="{companyTag}/edit/" Controller="Companies" Action="Edit">
			<Constraints>
				<item>
					<key>companyTag</key>
					<value>[\w-]+</value>
				</item>
			</Constraints>
		</RouteItem>
	</Routes>
	<IgnoreRoutes>
		<RouteItem Url="{resource}.axd/{*pathInfo}" />
	</IgnoreRoutes>
</RouteMappingConfiguration>