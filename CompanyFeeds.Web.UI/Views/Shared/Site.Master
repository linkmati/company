<%@ Master Language="C#" AutoEventWireup="false" CodeBehind="Site.master.cs" Inherits="CompanyFeeds.Web.UI.Views.Shared.Site" %>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en-us" lang="en-us">
<head>
    <link href="/styles/common.css?2019-01-03" rel="stylesheet" type="text/css" media="screen" />
    <link href="/styles/print.css?2009-04-01" rel="stylesheet" type="text/css" media="print" />
	<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.6.1/jquery.min.js" type="text/javascript"></script>
	<script src="/scripts/site.js?v=2011-10-24" type="text/javascript"></script>
	<script src="/scripts/resources.js" type="text/javascript" defer="defer"></script>
	<link rel="alternate" type="application/rss+xml" title="Press releases (Homepage)" href="<%= Domain %>/rss/" />
	<link rel="alternate" type="application/rss+xml" title="Press releases (Latest)" href="<%= Domain %>/rss/latest/" />
	<meta property="fb:app_id" content="203002446400259" />
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="HandheldFriendly" content="true">
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
	<asp:ContentPlaceHolder ID="HeadContent" runat="server" />
	<% Html.RenderPartial("StatsTrackingBegin"); %>
</head>
<body>
    <% if (Cache.SiteConfiguration.IsReadOnly) {%>
    <div style="color: #333333;background-color: #FEEFB3;padding: 6px; text-align: center; position: absolute; width: 100%;">
        The server is undergoing maintenance and this site is currently in read-only mode; we’ll return with full functionality soon.
    </div>
    <%}%>
	<div id="container">
		<div id="header" class="floatContainer">
			<div id="websiteLogo"><a href="/"><img src="/images/v2/logo.gif" alt="prsync" /></a></div>
			<div id="extra"><a href="/about/">What's this <span>?</span></a></div>
			<ul id="headerMenu">
				<uc:HtmlContainer id="pnlHeaderNotMember" runat="server">
					<li><%= Html.ActionLinkFormatted("Login", "Login", "Users", new{returnUrl=Request.Url.PathAndQuery}, new{rel="nofollow"})%></li>
					<li><%= Html.ActionLinkFormatted("Register", "Edit", "Users", null, new{rel="nofollow"})%></li>
					<li class="highlight additional"><%= Html.ActionLinkFormatted("Media agencies", "Edit", "Agencies") %></li>
					<li class="additional"><%= Html.ActionLinkFormatted("Submit a press release", "Add", "Entries")%></li>
				</uc:HtmlContainer>
				<uc:HtmlContainer id="pnlHeaderMember" runat="server" visible="false">
					<li><%= Html.ActionLinkFormatted("Logout", "Logout", "Users")%></li>
					<li runat="server" id="linkAgency" visible="false"><%= Html.ActionLinkFormatted("Edit agency", "Edit", "Agencies", new{agencyTag=User.AgencyTag}, null)%></li>
					<li><%= Html.ActionLinkFormatted("My account", "Edit", "Users", new{id=User.Id}, null)%></li>
					<li class="additional"><%= Html.ActionLinkFormatted("Submit company", "Add", "Companies")%></li>
					<li class="additional"><%= Html.ActionLinkFormatted("Submit a press release", "Add", "Entries")%></li>
					<li class="additional"><%= Html.ActionLinkFormatted("Follow companies", "List", "Subscriptions")%></li>
					<%if (!User.IsPremium) {%>
						<li class="highlight"><%= Html.ActionLinkFormatted("Get a premium account", "Premium", "Accounts")%></li>
					<%} %>
				</uc:HtmlContainer>
				<uc:HtmlContainer id="pnlHeaderAdmin" runat="server" visible="false">
					<li><%= Html.ActionLinkFormatted("Admin", "Dashboard", "Admin")%></li>
				</uc:HtmlContainer>
			</ul>
		</div>
		<div id="mainContainer" class="floatContainer">
			<div id="content">
				<div class="<%= User != null ? "member" : "notMember" %>">
					<asp:ContentPlaceHolder ID="MainContent" runat="server" />
				</div>
				<%Html.RenderPartial("SearchBox"); %>
			</div>	
			<div id="sidebar">
				<%Html.RenderPartial("SearchBoxMini"); %>
				<ul id="menu">
					<asp:Repeater runat="server" ID="repCategories">
						<ItemTemplate>
							<li class="menu<%# Container.ItemIndex %>"><%# Html.ActionLinkFormatted(Eval("CategoryName").ToString(), "Detail", "Categories", new {categoryTag = Eval("CategoryTag")}, new{@class=Eval("CategoryId").ToString()==Convert.ToString(ViewData["ActiveCategoryId"]) ? "active" : ""})%></li>
						</ItemTemplate>
					</asp:Repeater>
				</ul>
				<div class="twitter">
					<a href="http://twitter.com/prsync" rel="nofollow" target="_blank"><img src="/images/v2/twitter-en.gif" alt="Follow prsync on twitter" /></a>
				</div>
				<% /*Html.RenderPartial("CompanyHighlight"); */%>
				<div style="padding-left: 30px; padding-top: 10px;">
					<% Html.RenderPartial("Adslot", new{SlotId="5252231946", Width=160, Height=600}); %>
				</div>
				<div class="bottom"></div>
			</div>
		</div>
		<div id="footer">
			<ul>
				<li><%= Html.ActionLinkFormatted("About", "About", "Home")%></li>
				<li><%= Html.ActionLinkFormatted("Contact Us", "Contact", "Feedback", null, new{rel="nofollow"})%></li>
				<li><%= Html.ActionLinkFormatted("Report bug", "ReportBug", "Feedback", null, new{rel="nofollow"})%></li>
				<li><%= Html.ActionLinkFormatted("Report copyright infringements", "CopyrightInfringements", "Feedback", null, new { rel = "nofollow" })%></li>
				<li><%= Html.ActionLinkFormatted("Terms", "Terms", "Home", null, new{rel="nofollow"})%></li>
				<li><%= Html.ActionLinkFormatted("Archives", "ListDates", "Archives", null, null)%></li>
				<li><%= Html.ActionLinkFormatted("Company Index", "ListAll", "Companies")%></li>
				<li><%= Html.ActionLinkFormatted("Most viewed", "MostViewed", "Archives")%></li>
			</ul>
			<ul id="externalLinks">
				<li><a href="http://www.viglink.com/policies/ftc?vgtag=badge" class="text" rel="nofollow">Links monetized by <span style="background: transparent url(http://www.viglink.com/public/images/favicon.png) no-repeat 0% 50%; padding-left: 18px;"> VigLink</span></a></li>
			</ul>
		</div>
	</div>
	<!-- <%=ViewData["CachedStamp"]%> -->
	<% Html.RenderPartial("StatsTrackingEnd"); %>
	<uc:HtmlContainer id="pnlVigLink" runat="server">
		<script type="text/javascript">
		  var vglnk = { api_url: '//api.viglink.com/api',
						key: 'e4a7d750a71bfcc745b8e35db8553542' };

		  (function(d, t) {
			var s = d.createElement(t); s.type = 'text/javascript'; s.async = true;
			s.src = ('https:' == document.location.protocol ? vglnk.api_url :
					 '//cdn.viglink.com/api') + '/vglnk.js';
			var r = d.getElementsByTagName(t)[0]; r.parentNode.insertBefore(s, r);
		  }(document, 'script'));
		</script>
	</uc:HtmlContainer>
</body>
</html>
